#!/bin/sh
# Wrapper script to run opencode with bundled musl libraries
# This enables running on systems with older GLIBC versions

# Resolve our own location robustly: $0 may be a bare name (PATH lookup) or a
# symlink (e.g. a version manager shim), either of which breaks `dirname "$0"`.
SELF="$0"
case "$SELF" in
    */*) ;;
    *) SELF="$(command -v -- "$SELF" 2>/dev/null || printf '%s' "$SELF")" ;;
esac
SELF="$(readlink -f "$SELF" 2>/dev/null || printf '%s' "$SELF")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
if [ ! -x "${SCRIPT_DIR}/bin/opencode.bin" ]; then
    echo "opencode wrapper: cannot locate bin/opencode.bin (resolved $0 to $SELF)" >&2
    exit 127
fi

# Set up the musl loader symlink and library path file.
# The binary is patched (via patchelf) to use /tmp/.opencode-ld/ld-musl-x86_64.so.1
# as its ELF interpreter. The musl linker resolves its .path file relative to its
# grandparent directory (second-to-last / in its own path). Since the interpreter
# symlink is at /tmp/.opencode-ld/..., the grandparent is /tmp, so the .path file
# goes at /tmp/etc/ld-musl-x86_64.path.
LOADER_DIR="/tmp/.opencode-ld"
LOADER_PATH="${LOADER_DIR}/ld-musl-x86_64.so.1"
MUSL_PATH_FILE="/tmp/etc/ld-musl-x86_64.path"
LIB_DIR="${SCRIPT_DIR}/lib"
if [ ! -e "$LOADER_PATH" ] || [ "$(readlink -f "$LOADER_PATH" 2>/dev/null)" != "${LIB_DIR}/ld-musl-x86_64.so.1" ]; then
    mkdir -p "$LOADER_DIR" 2>/dev/null
    ln -sf "${LIB_DIR}/ld-musl-x86_64.so.1" "$LOADER_PATH" 2>/dev/null
fi
if [ ! -f "$MUSL_PATH_FILE" ] || [ "$(cat "$MUSL_PATH_FILE" 2>/dev/null)" != "$LIB_DIR" ]; then
    mkdir -p /tmp/etc 2>/dev/null
    printf '%s' "$LIB_DIR" > "$MUSL_PATH_FILE" 2>/dev/null
fi

exec "${SCRIPT_DIR}/bin/opencode.bin" "$@"
